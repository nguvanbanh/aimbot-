-- ===== [ NHÁNH 3: XỬ LÝ LOGIC TÌM MỤC TIÊU VÀ AIMBOT ] =====
local lockedTarget = nil

local function getClosestPlayerInFOV()
    local closestTarget = nil
    local shortestDistance = AimbotSettings.FOVRadius

    local mouseLocation = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if AimbotSettings.TeamCheck and player.Team == LocalPlayer.Team then
                continue
            end

            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
                local humanoid = character.Humanoid
                if AimbotSettings.CheckDead and humanoid.Health <= 0 then
                    continue
                end

                local hrp = character.HumanoidRootPart
                local screenPoint, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mouseLocation).Magnitude
                    if distance < shortestDistance then
                        if AimbotSettings.CheckWalls then
                            local origin = Camera.CFrame.Position
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
                            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                            
                            local result = Workspace:Raycast(origin, hrp.Position - origin, raycastParams)
                            if not result then
                                closestTarget = character
                                shortestDistance = distance
                            end
                        else
                            closestTarget = character
                            shortestDistance = distance
                        end
                    end
                end
            end
        end
    end

    return closestTarget
end

-- Vòng lặp cập nhật Aimbot liên tục
RunService.RenderStepped:Connect(function()
    -- Cập nhật hiển thị FOV
    FOVCircle.Visible = AimbotSettings.FOVVisible
    FOVCircle.Radius = AimbotSettings.FOVRadius
    FOVCircle.Position = UserInputService:GetMouseLocation()
    FOVCircle.Color = AimbotSettings.FOVColor

    if not AimbotSettings.Enabled then
        lockedTarget = nil
        return
    end

    -- Xử lý khóa mục tiêu
    if AimbotSettings.AlwaysLock or not lockedTarget or not lockedTarget.Parent or lockedTarget.Humanoid.Health <= 0 then
        lockedTarget = getClosestPlayerInFOV()
    end

    if lockedTarget and lockedTarget:FindFirstChild("HumanoidRootPart") then
        local hrp = lockedTarget.HumanoidRootPart
        local targetPosition = hrp.Position

        -- Tính năng Đoán Hướng (Prediction)
        if AimbotSettings.PredictionEnabled then
            targetPosition = targetPosition + (hrp.Velocity * AimbotSettings.Prediction)
        end

        if AimbotSettings.AimMode == "CFrame" then
            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, targetPosition)
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1 / math.max(AimbotSettings.Smoothness, 1))
        elseif AimbotSettings.AimMode == "Mouse" then
            local screenPoint = Camera:WorldToViewportPoint(targetPosition)
            local mouseLocation = UserInputService:GetMouseLocation()
            local moveX = (screenPoint.X - mouseLocation.X) / math.max(AimbotSettings.Smoothness, 1)
            local moveY = (screenPoint.Y - mouseLocation.Y) / math.max(AimbotSettings.Smoothness, 1)
            mousemoverel(moveX, moveY)
        end
    end
end)

